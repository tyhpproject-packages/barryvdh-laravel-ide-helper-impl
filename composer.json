{
    "name": "tyhpdef/barryvdh-laravel-ide-helper-impl",
    "description": "Implementation package for tyhpdef/barryvdh-laravel-ide-helper. Require tyhpdef/barryvdh-laravel-ide-helper, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "3.7.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": "8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/laravel-framework": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/barryvdh-laravel-ide-helper"
        }
    },
    "require": {
        "php": ">=8.2",
        "barryvdh/laravel-ide-helper": "3.7.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/laravel-framework": "@dev"
    }
}
